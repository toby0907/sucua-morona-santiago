btn('tRun',b=>{if(DRV.c){K.Brk=1;b.classList.add('on');return}runT=!runT;b.classList.toggle('on',runT);K.ShiftLeft=runT?1:0},b=>{K.Brk=0;if(!runT)b.classList.remove('on')});
btn('tHorn',b=>{K.Horn=1;b.classList.add('on')},b=>{K.Horn=0;b.classList.remove('on')});btn('tHb',b=>{K.Hb=1;b.classList.add('on')},b=>{K.Hb=0;b.classList.remove('on')});
btn('tE',()=>ev('KeyE'),()=>setTimeout(()=>dispatchEvent(new KeyboardEvent('keyup',{code:'KeyE'})),130));btn('tMap',()=>ev('KeyM'));btn('tCam',()=>toggleCam());btn('tPause',()=>ev('Escape'));
