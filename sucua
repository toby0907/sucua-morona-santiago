if(isTouch){document.body.classList.add('touch');
const joy=$('joy'),knob=$('knob'),R0=50;let jid=null,lid=null,lx=0,ly=0,jc=[0,0],runT=false;
const setK=(c,v)=>{K[c]=v?1:0},ev=c=>dispatchEvent(new KeyboardEvent('keydown',{code:c}));
const clearJoy=()=>{for(const c of['KeyW','KeyA','KeyS','KeyD'])K[c]=0;K.JF=K.JR=0;K.ShiftLeft=runT?1:0;knob.style.transform='translate(0,0)'};
function jmove(t){if(dlgOpen){clearJoy();return}let dx=t.clientX-jc[0],dy=t.clientY-jc[1];const d=Math.hypot(dx,dy)||1,m=Math.min(d,R0);dx=dx/d*m;dy=dy/d*m;knob.style.transform='translate('+dx+'px,'+dy+'px)';
const mg=Math.min(1,d/R0),jq=mg<.15?0:Math.pow((mg-.15)/.85,1.4);K.JF=-(dy/(m||1))*jq;K.JR=(dx/(m||1))*jq;
const nx=dx/R0,ny=dy/R0;setK('KeyA',nx<-.3);setK('KeyD',nx>.3);setK('KeyW',ny<-.3);setK('KeyS',ny>.3);K.ShiftLeft=(runT||d>R0*1.25)?1:0}
joy.addEventListener('touchstart',e=>{e.preventDefault();if(jid!==null)return;const t=e.changedTouches[0],r=joy.getBoundingClientRect();jid=t.identifier;jc=[r.left+r.width/2,r.top+r.height/2];jmove(t)},{passive:false});
R.domElement.addEventListener('touchstart',e=>{if(!playing)return;e.preventDefault();if(dlgOpen){nextLine();return}if(lid!==null)return;const t=e.changedTouches[0];lid=t.identifier;lx=t.clientX;ly=t.clientY},{passive:false});
addEventListener('touchmove',e=>{if(!playing)return;for(const t of e.changedTouches){if(t.identifier===jid){e.preventDefault();jmove(t)}else if(t.identifier===lid){e.preventDefault();if(!dlgOpen){P.yaw-=(t.clientX-lx)*sens*1.7;P.pitch=Math.max(-1.4,Math.min(1.4,P.pitch-(t.clientY-ly)*sens*1.7))}lx=t.clientX;ly=t.clientY}}},{passive:false});
const end=e=>{for(const t of e.changedTouches){if(t.identifier===jid){jid=null;clearJoy()}if(t.identifier===lid)lid=null}};
addEventListener('touchend',end);addEventListener('touchcancel',end);
const btn=(id,down,up)=>{const b=$(id);b.addEventListener('touchstart',e=>{e.preventDefault();down(b)},{passive:false});if(up)b.addEventListener('touchend',e=>{e.preventDefault();up(b)},{passive:false});b.addEventListener('touchcancel',()=>up&&up(b))};
